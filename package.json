{
  "name": "unifiedmandala-lite",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "node scripts/server.mjs",
    "dev": "concurrently \"node --watch scripts/server.mjs\" \"npm run metrics:serve\"",
    "metrics:serve": "node tools/metrics/patch-metrics.mjs || true && node tools/metrics/nile-wisdom-metrics.mjs",
    "maps:all": "node tools/maps-all.mjs",
    "mmd:render": "node tools/render-mermaid.mjs",
    "docs:bundle": "node tools/docops/build-presentation.mjs",
    "guardrails:check": "node tools/governance/crep-guardrails.mjs",
    "guardrails:hard": "CREP_GUARDRAILS_MODE=hard node tools/governance/crep-guardrails.mjs",
    "guardrails:auto": "CREP_GUARDRAILS_MODE=auto CREP_FAIL_ON=medium node tools/governance/crep-guardrails.mjs",
    "test": "node --test",
    "nile:metrics": "node tools/metrics/nile-wisdom-metrics.mjs",
    "nile:hvi": "node --loader ts-node/esm -e \"import('./src/adapters/hydro-variance.ts').then(m=>console.log(m.calculateHVI({region:'Nile-Delta',values:[4500,4600,4400,3800,4200,3900,3700]})))\"",
    "nile:blr": "node --loader ts-node/esm -e \"import('./src/adapters/buffer-load.ts').then(m=>console.log(m.calculateBLR({storage:150,demand:200})))\"",
    "nile:teleconnections": "node --loader ts-node/esm -e \"import('./src/adapters/teleconnection-watch.ts').then(m=>console.log(m.calculateImpactScore({enso:1.2,iod:-0.8,nao:0.5,region:'Nile'})))\"",
    "nile:stress": "node --loader ts-node/esm -e \"import('./src/adapters/institutional-stress.ts').then(m=>console.log(m.calculateStress({priceAnomaly:15.3,harvestAnomaly:10,supplyChainDelay:4})))\"",
    "nile:full:check": "npm run nile:hvi && npm run nile:blr && npm run nile:teleconnections && npm run nile:stress",
    "nile:prometheus": "npm run nile:metrics &",
    "crep:nile:check": "node tools/governance/crep-guardrails.mjs && node -e \"console.log('🌊 Nil-Weisheit CREP-konform')\"",
    "sigillin:nile:validate": "node -e \"const msgs=['🌊','🔴','🟠','🟢','💧','🧯','🛰️','🫀','🏛️','⚠️','🚨']; msgs.forEach(s=>console.log('Sigil valid:',s)); console.log('✅ Nil-Weisheit Sigils validated')\"",
    "test:qgw": "vitest run test/api.qgw.test.ts",
    "gallery:build": "node tools/generate-sigil-gallery.mjs",
    "pages:bundle": "node tools/docops/build-presentation.mjs",
    "pages:deploy": "gh-pages -d public",
    "postinstall": "node -e \"try{require('fs').mkdirSync('public/gallery',{recursive:true})}catch{}\"",
    "ci:smoke": "node tools/smoke/healthz.mjs && node tools/smoke/kpis.mjs",
    "demo:hydro": "node -e \"console.log('HVI/BLR/Tele live…');\"",
    "test:live": "vitest run -t hvi-live",
    "metrics:mini": "node tools/metrics/patch-metrics.mjs",
    "docs:serve": "npx http-server docs -p 4100",
    "smoke": "node tools/smokes/healthz.mjs && node tools/smokes/kpis.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.18",
    "express": "^4.19.2",
    "node-cron": "^4.2.1",
    "pino": "^8.17.0",
    "pino-http": "^8.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "zod": "^4.1.5",
    "cors": "^2.8.5",
    "simple-statistics": "^7.8.3"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "yaml": "^2.6.0",
    "concurrently": "^8.2.2",
    "prom-client": "^14.2.0",
    "vitest": "^1.6.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^2.0.12",
    "gh-pages": "^6.1.1"
  }
}