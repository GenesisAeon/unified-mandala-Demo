  "dependencies": {
    "dayjs": "^1.11.18",
    "express": "^4.19.2",
    "node-cron": "^4.2.1",
    "pino": "^8.17.0",
    "pino-http": "^8.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "yaml": "^2.5.0"
  }
}
